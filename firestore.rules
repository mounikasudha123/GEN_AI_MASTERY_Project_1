rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if owns(uid);
      match /{collection}/{recordId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && request.resource.data.userId == uid;
      }
    }
  }
}
